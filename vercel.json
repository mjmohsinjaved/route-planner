{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "functions": { "api/index.py": { "maxDuration": 60 } }
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/admin(.*)", "dest": "api/index.py" },
    { "src": "/static/(.*)", "dest": "api/index.py" },

    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/([^/]+\\.(svg|png|ico|txt|json|webmanifest))", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
